# ====== KONFIGURASI BACKEND SUARANUSANTARA ======
PORT=5000
DATABASE_URL="file:./dev.db"

# Ganti dengan string acak yang panjang untuk produksi
JWT_SECRET="ganti-dengan-rahasia-panjang-suaranusantara-2026"
JWT_EXPIRES_IN="8h"

# Origin frontend yang diizinkan (pisahkan dengan koma)
